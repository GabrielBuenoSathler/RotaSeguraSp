POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=Criminalidade
APP_ENV=development
SQL_ECHO=false
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_TIMEOUT_SECONDS=30
ROUTE_ALTERNATES=2
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
RISK_RADIUS_METERS=50
RISK_WINDOW_DAYS=365
# Ative apenas após identificar uma coluna date/timestamp/timestamptz na sua base:
# OCCURRENCE_DATE_COLUMN=data_ocorrencia
DATASET_SOURCE="Base de ocorrências importada pelo administrador"
# DATASET_UPDATED_AT=2026-10-13
# Instância própria ou provedor compatível com a API Nominatim:
# NOMINATIM_URL=http://seu-geocoder:8080
GEOCODER_USER_AGENT=RotaSeguraSP/0.1
# No Docker, use URLs acessíveis na rede dos contêineres para os serviços acima.
# O frontend Docker usa /api por padrão; configure VITE_API_URL se usar outra API.

# Coluna DATE/TIMESTAMP para agrupar ocorrências por mês (não aplica filtro temporal)
OCCURRENCE_GROUP_DATE_COLUMN=data_ocorrencia_bo
