APP_ENV=production
POSTGRES_ADMIN_USER=rotasegura_admin
POSTGRES_ADMIN_PASSWORD=defina-uma-senha-admin-prod
POSTGRES_USER=rotasegura_app
POSTGRES_PASSWORD=defina-uma-senha-exclusiva-prod
POSTGRES_DATABASE=rotasegura_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_PORT=5443
BIND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
SQL_ECHO=false
CORS_ORIGINS=[]
VALHALLA_URL=http://host.docker.internal:8002
VALHALLA_TIMEOUT_SECONDS=30
ROUTE_ALTERNATES=2
RISK_RADIUS_METERS=50
RISK_WINDOW_DAYS=365
DATASET_SOURCE="Base de ocorrências importada pelo administrador"
GEOCODER_USER_AGENT=RotaSeguraSP/0.1
